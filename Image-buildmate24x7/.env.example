# Local development only. Replace every value before deployment; never commit .env.
IMAGE_CLOUD_DB_NAME=buildmate_image_cloud
IMAGE_CLOUD_DB_USER=image_cloud
IMAGE_CLOUD_DB_PASSWORD=replace-with-long-random-secret
IMAGE_CLOUD_DATABASE_URL=postgresql+psycopg://image_cloud:replace-with-long-random-secret@db:5432/buildmate_image_cloud
IMAGE_CLOUD_JWT_SECRET=replace-with-at-least-32-random-bytes
IMAGE_CLOUD_JWT_TTL_MINUTES=10080
IMAGE_CLOUD_AUTH_COOKIE_SECURE=false
IMAGE_CLOUD_ENABLE_API_DOCS=false
IMAGE_CLOUD_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
IMAGE_CLOUD_BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-start
IMAGE_CLOUD_CORS_ORIGINS=["http://localhost:5173"]
IMAGE_CLOUD_DASHBOARD_PORT=5173
IMAGE_CLOUD_API_PORT=8000
IMAGE_CLOUD_STORAGE_ROOT=/var/lib/buildmate-image-cloud
IMAGE_CLOUD_CDN_ORIGIN=http://localhost:8000
IMAGE_CLOUD_UPLOAD_MAX_BYTES=52428800
IMAGE_CLOUD_UPLOAD_MAX_PIXELS=80000000
IMAGE_CLOUD_IMGPROXY_BASE_URL=
IMAGE_CLOUD_ALLOWED_HOSTS=["localhost","127.0.0.1","images.buildmate24x7.com","cdn.buildmate24x7.com"]
