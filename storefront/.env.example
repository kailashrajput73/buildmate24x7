# Where the .NET API runs (server-side fetches and the /api proxy)
API_URL=http://localhost:5080
# "sandbox" or "production" — must match the API's Cashfree environment
NEXT_PUBLIC_CASHFREE_MODE=sandbox
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase phone login (web app config from the Firebase console — these are public identifiers, not secrets).
